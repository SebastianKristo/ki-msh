[
  {
    "name": "Hjem · header+prosa+søppel+gjøremål",
    "cards": [
      {
        "type": "custom:msh-hjem-header-card"
      },
      {
        "type": "custom:msh-prosa-card"
      },
      {
        "type": "custom:msh-soppel-card",
        "type_sensor": "sensor.soppel_type"
      },
      {
        "type": "custom:msh-hjem-gjoremal-card"
      }
    ]
  },
  {
    "name": "Hjem · header hjem-modus",
    "cards": [
      {
        "type": "custom:msh-hjem-header-card",
        "mode": "hjem",
        "show_name": true,
        "show_place": true
      },
      {
        "type": "custom:msh-hjem-header-card",
        "mode": "profil"
      },
      {
        "type": "custom:msh-hjem-header-card",
        "mode": "stor"
      },
      {
        "type": "custom:msh-hjem-header-card",
        "mode": "kompakt",
        "badge": "ring",
        "size": "L"
      }
    ]
  },
  {
    "name": "Hjem · prosa egendefinert",
    "cards": [
      {
        "type": "custom:msh-prosa-card",
        "prose": [
          {
            "id": "a",
            "pre": "Døra er",
            "src": "lock",
            "post": ".",
            "icon": "🔒",
            "color": "auto",
            "act": "lock_toggle"
          },
          {
            "id": "b",
            "pre": "Alarmen er",
            "src": "alarm",
            "post": "og det er {stue.temp} i stua.",
            "color": "auto"
          },
          {
            "id": "c",
            "pre": "Søppel hentes",
            "src": "trash",
            "post": ".",
            "icon": "🗑️",
            "link": "#soppel",
            "cop": "<",
            "csrc": "trash",
            "cval": "3"
          },
          {
            "id": "d",
            "pre": "Skjult",
            "src": "text",
            "fmt": "tekst",
            "hidden": true
          }
        ]
      }
    ]
  },
  {
    "name": "Hjem · tom config",
    "cards": [
      {
        "type": "custom:msh-soppel-card",
        "sensor": "sensor.finnes_ikke"
      },
      {
        "type": "custom:msh-hjem-gjoremal-card",
        "exclude": [
          "todo.handleliste",
          "todo.store_oppgaver"
        ]
      },
      {
        "type": "custom:msh-prosa-card",
        "prose": []
      },
      {
        "type": "custom:msh-hjem-header-card",
        "exclude": [
          "person.sebastian",
          "person.cybele",
          "person.rune"
        ],
        "overrides": {
          "weather": "weather.finnes_ikke"
        },
        "mode": "hjem"
      }
    ]
  },
  {
    "name": "Hjem · header personer visning",
    "cards": [
      {
        "type": "custom:msh-hjem-header-card",
        "persons": [
          {
            "entity": "person.sebastian",
            "display": "picture"
          },
          {
            "entity": "person.cybele",
            "display": "initials"
          },
          {
            "entity": "person.rune",
            "display": "icon"
          }
        ]
      },
      {
        "type": "custom:msh-hjem-header-card",
        "persons_cfg": {
          "sebastian": {
            "display": "icon"
          },
          "cybele": {
            "picture": "/local/cybele.jpg"
          }
        }
      }
    ]
  },
  {
    "name": "Hjem · prosa tekststørrelse",
    "cards": [
      {
        "type": "custom:msh-prosa-card",
        "prose_font_size": 2.8,
        "prose_line_height": 2
      },
      {
        "type": "custom:msh-prosa-card",
        "prose_font_size": 1.4,
        "prose_line_height": 1.3
      }
    ]
  },
  {
    "name": "Hjem · header soner og tittelhandlinger",
    "cards": [
      {
        "type": "custom:msh-hjem-header-card",
        "people": [
          {
            "person": "person.emma",
            "home_switch": "input_boolean.emma_hjemme"
          },
          {
            "person": "person.rune",
            "home_switch": "input_boolean.rune_hjemme"
          },
          {
            "person": "person.sebastian"
          },
          {
            "person": "person.cybele"
          }
        ],
        "zones": {
          "zone.skole": {
            "icon": "mdi:school",
            "color": "var(--blue)"
          }
        },
        "title_actions": {
          "tap": "server",
          "double_tap": "config",
          "hold": "kiosk"
        },
        "kiosk_entity": "input_boolean.kiosk_mode"
      },
      {
        "type": "custom:msh-hjem-header-card",
        "mode": "profil",
        "away_marker": true,
        "title_actions": {
          "double_tap": "none"
        }
      }
    ]
  },
  {
    "name": "Hjem · prosa fast tekststørrelse + stor hilsen",
    "cards": [
      {
        "type": "custom:msh-hjem-header-card",
        "mode": "stor",
        "g_gap": -8
      },
      {
        "type": "custom:msh-prosa-card",
        "prose_font_size": 1.8,
        "prose_line_height": 1.4
      }
    ]
  },
  {
    "name": "Hjem · header personer (hjemme/søvn/sone)",
    "cards": [
      {
        "type": "custom:msh-hjem-header-card",
        "mode": "hjem",
        "show_place": true,
        "people": [
          {
            "person": "person.emma",
            "home": "input_boolean.emma_hjemme"
          },
          {
            "person": "person.rune",
            "home": "input_boolean.rune_hjemme",
            "sleep": "input_boolean.cybele_sover"
          },
          {
            "person": "person.sebastian",
            "zone": false
          }
        ],
        "zones": {
          "zone.skole": {
            "icon": "mdi:school",
            "color": "var(--yellow)"
          }
        },
        "zone_away": {
          "icon": "mdi:airplane",
          "color": "var(--purple)"
        }
      },
      {
        "type": "custom:msh-hjem-header-card",
        "mode": "familie",
        "persons": {
          "emma": {
            "home": "input_boolean.emma_hjemme",
            "zone": false
          }
        },
        "overrides": {
          "sover_emma": "input_boolean.cybele_sover"
        }
      }
    ]
  }
]
